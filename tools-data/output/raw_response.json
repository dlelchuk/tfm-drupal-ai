: {\n      \"id\": \"AC\",\n      \"nombre\": \"Accesibilidad\"\n    },\n    \"subdimension\": {\n      \"id\": \"ACog\",\n      \"nombre\": \"Accesibilidad cognitiva\"\n    },\n    \"categoria\": \"FONDO\",\n    \"recomendacion\": \"Los pictogramas suelen tener un fondo blanco. En el caso de los usuarios de CAA, los pictogramas pueden tener un fondo de color dependiendo de la clase gramatical de la palabra representada.\",\n    \"ejemplo\": null\n  },\n  {\n    \"id\": 159,\n    \"pagina_inicio\": 33,\n    \"pagina_fin\": 33,\n    \"dimension\": {\n      \"id\": \"AC\",\n      \"nombre\": \"Accesibilidad\"\n    },\n    \"subdimension\": {\n      \"id\": \"ACog\",\n      \"nombre\": \"Accesibilidad cognitiva\"\n    },\n    \"categoria\": \"TEXTO\",\n    \"recomendacion\": \"Algunos pictogramas pueden ser difíciles de adivinar si no muestran su etiqueta o título. Los pictogramas deben tener una leyenda o transcripción encima o debajo de la imagen en la lengua materna del estudiante.\",\n    \"ejemplo\": \"[Image of answer]\"\n  },\n  {\n    \"id\": 160,\n    \"pagina_inicio\": 34,\n    \"pagina_fin\": 34,\n    \"dimension\": {\n      \"id\": \"AC\",\n      \"nombre\": \"Accesibilidad\"\n    },\n    \"subdimension\": {\n      \"id\": \"ACog\",\n      \"nombre\": \"Accesibilidad cognitiva\"\n    },\n    \"categoria\": \"TEXTO BILINGÜE\",\n    \"recomendacion\": \"En el caso de contextos bilingües, puede colocarse un texto arriba y otro abajo.\",\n    \"ejemplo\": \"[Image of shy]\"\n  },\n  {\n    \"id\": 161,\n    \"pagina_inicio\": 34,\n    \"pagina_fin\": 34,\n    \"dimension\": {\n      \"id\": \"AC\",\n      \"nombre\": \"Accesibilidad\"\n    },\n    \"subdimension\": {\n      \"id\": \"ACog\",\n      \"nombre\": \"Accesibilidad cognitiva\"\n    },\n    \"categoria\": \"COHERENCIA\",\n    \"recomendacion\": \"Utilice los mismos pictogramas en todo el recurso, es decir, no cambie el tipo de pictograma que ha utilizado para el mismo concepto en todo el recurso.\",\n    \"ejemplo\": null\n  },\n  {\n    \"id\": 162,\n    \"pagina_inicio\": 34,\n    \"pagina_fin\": 34,\n    \"dimension\": {\n      \"id\": \"AC\",\n      \"nombre\": \"Accesibilidad\"\n    },\n    \"subdimension\": {\n      \"id\": \"ACog\",\n      \"nombre\": \"Accesibilidad cognitiva\"\n    },\n    \"categoria\": \"AMBIGÜEDAD\",\n    \"recomendacion\": \"Explique al estudiante que muchos conceptos pueden representarse con el mismo pictograma y viceversa.\",\n    \"ejemplo\": \"Ejemplo del mismo pictograma para las palabras ganar, el primero, ganador, premio.\"\n  },\n  {\n    \"id\": 163,\n    \"pagina_inicio\": 34,\n    \"pagina_fin\": 34,\n    \"dimension\": {\n      \"id\": \"AC\",\n      \"nombre\": \"Accesibilidad\"\n    },\n    \"subdimension\": {\n      \"id\": \"ACog\",\n      \"nombre\": \"Accesibilidad cognitiva\"\n    },\n    \"categoria\": \"ABSTRACCIÓN\",\n    \"recomendacion\": \"Evite los pictogramas demasiado abstractos. Es difícil interpretar su significado.\",\n    \"ejemplo\": \"[Image of future]\"\n  },\n  {\n    \"id\": 164,\n    \"pagina_inicio\": 35,\n    \"pagina_fin\": 35,\n    \"dimension\": {\n      \"id\": \"AC\",\n      \"nombre\": \"Accesibilidad\"\n    },\n    \"subdimension\": {\n      \"id\": \"ACog\",\n      \"nombre\": \"Accesibilidad cognitiva\"\n    },\n    \"categoria\": \"DETALLES\",\n    \"recomendacion\": \"Procure utilizar siempre pictogramas que se ajusten a la complejidad de lo que representan.\",\n    \"ejemplo\": \"[Image of speech language therapist]\"\n  },\n  {\n    \"id\": 165,\n    \"pagina_inicio\": 35,\n    \"pagina_fin\": 35,\n    \"dimension\": {\n      \"id\": \"AC\",\n      \"nombre\": \"Accesibilidad\"\n    },\n    \"subdimension\": {\n      \"id\": \"ACog\",\n      \"nombre\": \"Accesibilidad cognitiva\"\n    },\n    \"categoria\": \"VARIEDAD\",\n    \"recomendacion\": \"Las ilustraciones son útiles para contenidos científicos complejos. Las escenas visuales proporcionan un contexto útil para narrar historias, procesos o hechos.\",\n    \"ejemplo\": \"[Image of party]\"\n  },\n  {\n    \"id\": 166,\n    \"pagina_inicio\": 35,\n    \"pagina_fin\": 35,\n    \"dimension\": {\n      \"id\": \"AC\",\n      \"nombre\": \"Accesibilidad\"\n    },\n    \"subdimension\": {\n      \"id\": \"ACog\",\n      \"nombre\": \"Accesibilidad cognitiva\"\n    },\n    \"categoria\": \"DIDÁCTICAS\",\n    \"recomendacion\": \"Los pictogramas deben representar conceptos que el estudiante entienda o pueda entender (zona de desarrollo próximo).\",\n    \"ejemplo\": null\n  },\n  {\n    \"id\": 167,\n    \"pagina_inicio\": 35,\n    \"pagina_fin\": 35,\n    \"dimension\": {\n      \"id\": \"AC\",\n      \"nombre\": \"Accesibilidad\"\n    },\n    \"subdimension\": {\n      \"id\": \"ACog\",\n      \"nombre\": \"Accesibilidad cognitiva\"\n    },\n    \"categoria\": \"EDAD DE LOS USUARIOS\",\n    \"recomendacion\": \"Los pictogramas deben ser adecuados a la edad del estudiante.\",\n    \"ejemplo\": \"Pictogramas de la palabra mujer para estudiantes adultos y jóvenes:\"\n  },\n  {\n    \"id\": 168,\n    \"pagina_inicio\": 36,\n    \"pagina_fin\": 36,\n    \"dimension\": {\n      \"id\": \"AC\",\n      \"nombre\": \"Accesibilidad\"\n    },\n    \"subdimension\": {\n      \"id\": \"ACog\",\n      \"nombre\": \"Accesibilidad cognitiva\"\n    },\n    \"categoria\": \"NIVEL DE ALFABETIZACIÓN\",\n    \"recomendacion\": \"Utilice pictogramas adecuados al nivel de alfabetización del estudiante.\",\n    \"ejemplo\": null\n  },\n  {\n    \"id\": 169,\n    \"pagina_inicio\": 36,\n    \"pagina_fin\": 36,\n    \"dimension\": {\n      \"id\": \"AC\",\n      \"nombre\": \"Accesibilidad\"\n    },\n    \"subdimension\": {\n      \"id\": \"ACog\",\n      \"nombre\": \"Accesibilidad cognitiva\"\n    },\n    \"categoria\": \"AUTONOMÍA PERSONAL\",\n    \"recomendacion\": \"Los pictogramas pueden ayudar a fomentar la autonomía personal en la realización de tareas relacionadas con el recurso educativo. Ejemplo de buenas